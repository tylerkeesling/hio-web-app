# User-specific configuration
# Copy this file to .env.local.user and fill in your values before running the bootstrap script
# The bootstrap script will merge these values into .env.local

# The base URL of your application (e.g., http://localhost:3000 for local development)
APP_BASE_URL=http://localhost:3000

# Your Auth0 tenant domain (e.g., your custom domain for your tenant or your-tenant.us.auth0.com if you haven't set up a custom domain)
NEXT_PUBLIC_AUTH0_DOMAIN=

# Session encryption secret (generate with: openssl rand -hex 32)
SESSION_ENCRYPTION_SECRET=

# The namespace used to prefix custom claims (e.g., https://example.com)
CUSTOM_CLAIMS_NAMESPACE=https://example.com

# Onboarding: set to false to skip the email verification step before creating an organization
# (default: true)
REQUIRE_EMAIL_VERIFICATION=true

# Shared secret the Belay Provisioning Action presents when it calls /api/provision
# (generate with: openssl rand -hex 32; the bootstrap generates one if this is empty)
PROVISIONING_API_KEY=

# Optional: the GitHub social connection ID, enabled on every new workspace
# (created by: npm run demo:github <client_id> <client_secret>)
GITHUB_CONNECTION_ID=
